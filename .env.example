# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Azshrtr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Match the URL you open in the browser (Herd: https://azshrtr.test · Docker: http://localhost:8080).
APP_URL=https://azshrtr.test
# Docker Compose only — force absolute links to APP_URL when the container port differs from the published host port.
# APP_FORCE_URL=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

# Release identity (optional locally; Docker/CI bake these into the image).
# SemVer source of truth is the VERSION file when these are unset.
# AZSHRTR_VERSION=0.0.1
# AZSHRTR_BUILD=1
# AZSHRTR_COMMIT=unknown

# -----------------------------------------------------------------------------
# Logging / Nightwatch
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Database (MariaDB primary; SQLite OK for local/demo)
# -----------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=azshrtr
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session / Sanctum
# -----------------------------------------------------------------------------
# Prefer: database (default / shared hosting) or redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=azshrtr.test,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Console social login — leave empty to disable
# -----------------------------------------------------------------------------
CONSOLE_GOOGLE_CLIENT_ID=
CONSOLE_GOOGLE_CLIENT_SECRET=
CONSOLE_GITHUB_CLIENT_ID=
CONSOLE_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Queue / cache / filesystem (Redis optional)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Herd Pro mail catcher: open the Mail UI in Herd (not Mailpit :8025).
# Inbox is grouped by MAIL_USERNAME — use APP_NAME so messages show under azshrtr.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME="${APP_NAME}"
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@azshrtr.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS (optional — S3 / assets)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Azshrtr — product
# -----------------------------------------------------------------------------
AZSHRTR_DOMAIN_ROOT=azshrtr.test
AZSHRTR_DOMAIN_DNS_VERIFY=true
AZSHRTR_CUSTOM_DOMAIN_CNAME_TARGET=customers.azshrtr.com
AZSHRTR_GUEST_LINK_TTL_MINUTES=30
AZSHRTR_USAGE_TIMEZONE=UTC
# Import caps (keep under PHP post_max_size / nginx client_max_body_size; Docker defaults to 12M)
# AZSHRTR_IMPORT_MAX_ROWS=10000
# AZSHRTR_IMPORT_MAX_PAYLOAD_BYTES=5242880
# Shared hosting: process short-lived queue jobs from the 1-minute cron
AZSHRTR_CRON_QUEUE=true

# -----------------------------------------------------------------------------
# Azshrtr — billing (Dodo Payments) — Cloud optional
# -----------------------------------------------------------------------------
AZSHRTR_BILLING_ENABLED=false
AZSHRTR_BILLING_CURRENCY=USD

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_ID=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_PAYMENTS_RETURN_URL="${APP_URL}/console/{organization_id}/billing"
DODO_PRODUCT_PRO=

# -----------------------------------------------------------------------------
# Cloudflare for SaaS (custom short domains)
# -----------------------------------------------------------------------------
CLOUDFLARE_CUSTOM_HOSTNAMES_ENABLED=false
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CUSTOM_HOSTNAME_SSL_METHOD=txt

# -----------------------------------------------------------------------------
# Marketing / SEO
# -----------------------------------------------------------------------------
# MARKETING_URL="${APP_URL}"
# GOOGLE_SITE_VERIFICATION=
# GOOGLE_TAG_MANAGER_ID=
# GOOGLE_ANALYTICS_ID=
